---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from './Base.astro';
import type { BlogEntry } from '../lib/content';
import { getLocale, useTranslations, localizePath, formatDate } from '../i18n/utils';

interface Props {
  entry: BlogEntry;
}
const { entry } = Astro.props;
const { data } = entry;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { Content } = await render(entry);
---

<Base title={data.title} description={data.description} type="article" image={data.cover?.src}>
  <article class="container-page py-14 sm:py-20">
    <a
      href={localizePath('/blog', locale)}
      class="link-slide text-sm text-muted transition-colors hover:text-text"
    >
      ← {t('writing.back')}
    </a>

    <header class="mt-8 max-w-3xl" data-reveal>
      <p class="font-mono text-xs text-muted">
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
      </p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-6xl">
        <span class="text-gradient">{data.title}</span>
      </h1>
      <p class="mt-4 text-lg text-muted">{data.description}</p>
    </header>

    {
      data.cover && (
        <Image
          src={data.cover}
          alt={data.title}
          widths={[600, 960, 1400]}
          class="mt-10 w-full rounded-[var(--radius-card)] border border-border shadow-[var(--shadow-card)]"
        />
      )
    }

    <div class="prose-content mt-10" data-reveal>
      <Content />
    </div>
  </article>
</Base>
