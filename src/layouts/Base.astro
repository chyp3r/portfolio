---
import '../styles/global.css';
import { SITE } from '../consts';
import { getLocale, useTranslations, switchLocalePath, otherLocale } from '../i18n/utils';
import ThemeScript from '../components/ThemeScript.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  /** `article` for blog posts / project pages. */
  type?: 'website' | 'article';
  noindex?: boolean;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const {
  title,
  description = t('site.description'),
  image = SITE.ogImage,
  type = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : t('site.title');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const altHref = new URL(switchLocalePath(Astro.url, otherLocale(locale)), SITE.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.role,
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Hacettepe University' },
    { '@type': 'EducationalOrganization', name: 'Deneyap Technology Workshops' },
  ],
  sameAs: [
    'https://github.com/chyp3r',
    'https://www.linkedin.com/in/gokdenizkuruca/',
    'https://chyp3r.itch.io/',
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ThemeScript />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#15151f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5fb" media="(prefers-color-scheme: light)" />

    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>

  <body>
    <div class="starfield" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:shadow-card"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
