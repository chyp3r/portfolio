---
import '../styles/global.css';
import { SITE } from '../consts';
import { getLocale, useTranslations, switchLocalePath, otherLocale } from '../i18n/utils';
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../components/ThemeScript.astro';
import Motion from '../components/Motion.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  /** `article` for blog posts / project pages. */
  type?: 'website' | 'article';
  noindex?: boolean;
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = t('site.description'),
  image = `${base}/${SITE.ogImage}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : t('site.title');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE.url).href;
const altHref = new URL(switchLocalePath(Astro.url, otherLocale(locale)), SITE.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  ...(SITE.email ? { email: `mailto:${SITE.email}` } : {}),
  jobTitle: SITE.role,
  worksFor: [
    { '@type': 'Organization', name: 'ASELSAN' },
    { '@type': 'ResearchOrganization', name: 'ASELLABS AI Laboratory' },
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Hacettepe University' },
    { '@type': 'EducationalOrganization', name: 'Deneyap Technology Workshops' },
  ],
  sameAs: [
    'https://github.com/chyp3r',
    'https://www.linkedin.com/in/gokdenizkuruca/',
    'https://chyp3r.itch.io/',
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <ThemeScript />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#15151f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5fb" media="(prefers-color-scheme: light)" />

    <ClientRouter />
    <noscript>
      <style>
        [data-reveal],
        .reveal,
        .word {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
          animation: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>

  <body>
    <div class="ambient" aria-hidden="true">
      <div class="aurora"><span></span><span></span><span></span></div>
      <div class="grid-overlay"></div>
      <div class="grain"></div>
    </div>
    <div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:shadow-card"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <button
      type="button"
      class="to-top glass"
      data-to-top
      data-show="false"
      aria-label="Back to top"
    >
      <svg class="to-top__ring" viewBox="0 0 44 44" aria-hidden="true">
        <circle cx="22" cy="22" r="20" stroke="var(--color-border)"></circle>
        <circle cx="22" cy="22" r="20" stroke="var(--color-accent)" data-to-top-ring></circle>
      </svg>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M12 20V4m0 0-6 6m6-6 6 6"></path>
      </svg>
    </button>

    <Motion />
  </body>
</html>
