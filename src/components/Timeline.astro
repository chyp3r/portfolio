---
import { getLocale, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

type Item = { period: string; en: [string, string]; tr: [string, string] };

const items: Item[] = [
  {
    period: '2026',
    en: [
      'AI Developer Intern — ASELSAN',
      'Autonomous coding agent in the UGES AI Applications Design Directorate: reasoning and function calling over MCP with RAG on Qdrant; local LLM inference tuned on Ollama and vLLM.',
    ],
    tr: [
      'Yapay Zekâ Geliştirici Stajyeri — ASELSAN',
      'UGES YZ Uygulamaları Tasarım Direktörlüğü’nde otonom kodlama ajanı: MCP üzerinden akıl yürütme ve fonksiyon çağırma, Qdrant tabanlı RAG; Ollama ve vLLM ile yerel LLM çıkarımı optimizasyonu.',
    ],
  },
  {
    period: '2026 →',
    en: [
      'AI Developer & Researcher — ASELLABS (ASELSAN × Hacettepe)',
      'Agentic RAG on autonomous LangGraph workflows over ONVIF image streams, with Qdrant hybrid search, LoRA fine-tuning research and AI guardrails.',
    ],
    tr: [
      'Yapay Zekâ Geliştiricisi & Araştırmacı — ASELLABS (ASELSAN × Hacettepe)',
      'ONVIF görüntü akışları üzerinde otonom LangGraph iş akışlarıyla Agentic RAG; Qdrant hibrit arama, LoRA ince ayar araştırması ve YZ guardrail’leri.',
    ],
  },
  {
    period: '2026 →',
    en: [
      'Research — Mechanistic theory of artificial sociality',
      'Hybrid semantic-topological networks for LLM-agent societies, with Asst. Prof. Engin Demir. Manuscript in preparation.',
    ],
    tr: [
      'Araştırma — Yapay sosyalliğin mekanizma teorisi',
      'LLM ajan toplulukları için hibrit anlamsal-topolojik ağlar; Dr. Öğr. Üyesi Engin Demir ile. Makale hazırlanıyor.',
    ],
  },
  {
    period: '2026',
    en: [
      'AI Developer Intern — Turkcell',
      'Multi-agent systems and RAG pipelines on Gemini + LangGraph + pgvector (+15% automation efficiency), plus a benchmarking platform for Hugging Face TTS models.',
    ],
    tr: [
      'Yapay Zekâ Geliştirici Stajyeri — Turkcell',
      'Gemini + LangGraph + pgvector üzerinde çok ajanlı sistemler ve RAG hatları (%15 otomasyon verimliliği artışı) ve Hugging Face TTS modelleri için kıyaslama platformu.',
    ],
  },
  {
    period: '2025',
    en: [
      '1st place — Anadolu Agency Media Technologies Hackathon',
      'Team lead & AI developer on ODAK, a GenAI news platform with a Dockerised Django backend and automated video generation.',
    ],
    tr: [
      'Birincilik — Anadolu Ajansı Medya Teknolojileri Hackathonu',
      'ODAK adlı GenAI haber platformunda takım lideri ve YZ geliştiricisi; Dockerize Django backend ve otomatik video üretimi.',
    ],
  },
  {
    period: '2025',
    en: [
      'Software Developer Intern — OBSS Technology',
      'Native iOS app in Swift/UIKit (+30% maintainability via MVVM) and a Gemini-powered chatbot with Moya and Core Data.',
    ],
    tr: [
      'Yazılım Geliştirici Stajyeri — OBSS Technology',
      'Swift/UIKit ile native iOS uygulaması (MVVM ile %30 daha bakımlı kod) ve Moya + Core Data kullanan Gemini destekli sohbet botu.',
    ],
  },
  {
    period: '2025',
    en: [
      '1st at Kamp+ T3 Ideathon · 2nd at HAVELSAN Hackathon',
      'Led an 8-person team on ViT-based disease detection and neural-network yield estimation.',
    ],
    tr: [
      'Kamp+ T3 Ideathon birinciliği · HAVELSAN Hackathon ikinciliği',
      '8 kişilik ekiple ViT tabanlı hastalık tespiti ve sinir ağı tabanlı verim tahmini sistemleri.',
    ],
  },
  {
    period: '2024',
    en: [
      'Best Presentation Award — Teknofest AI in Health',
      'Albumentations augmentation pipeline with YOLOv8, BART and LSTM for classification and NER — 0.55 mAP, 0.95 F1.',
    ],
    tr: [
      'En İyi Sunum Ödülü — Teknofest Sağlıkta Yapay Zekâ',
      'Albumentations ile veri artırma hattı; sınıflandırma ve NER için YOLOv8, BART ve LSTM — 0,55 mAP, 0,95 F1.',
    ],
  },
  {
    period: '2024',
    en: [
      'Co-founder & Chairperson — Hacettepe R&D Community (HARGET)',
      'Led a 20-member board across web, mobile and AI teams, delivering projects and events.',
    ],
    tr: [
      'Kurucu Ortak & Başkan — Hacettepe Ar-Ge Topluluğu (HARGET)',
      '20 kişilik yönetim kurulunu yönettim; web, mobil ve YZ ekipleriyle projeler ve etkinlikler yürüttük.',
    ],
  },
  {
    period: '2023',
    en: [
      'Teknofest Teams Lead — ACM Hacettepe',
      'Managed 15 teams across six R&D units and streamlined their competition workflows.',
    ],
    tr: [
      'Teknofest Takımları Lideri — ACM Hacettepe',
      'Altı Ar-Ge birimindeki 15 takımı yönettim ve yarışma süreçlerini düzenledim.',
    ],
  },
  {
    period: '2023 →',
    en: [
      'Computer Engineering, Hacettepe University',
      'R&D student club and ACM Hacettepe competition teams. Expected graduation June 2027.',
    ],
    tr: [
      'Bilgisayar Mühendisliği, Hacettepe Üniversitesi',
      'Ar-Ge öğrenci kulübü ve ACM Hacettepe yarışma takımları. Beklenen mezuniyet: Haziran 2027.',
    ],
  },
  {
    period: '2022',
    en: [
      'Deneyap Technology Workshops — graduate',
      'Four years across AI, robotics, IoT, energy, mobile and design tracks.',
    ],
    tr: [
      'Deneyap Teknoloji Atölyeleri — mezun',
      'YZ, robotik, IoT, enerji, mobil ve tasarım eğitimlerinde dört yıl.',
    ],
  },
];
---

<section class="container-page py-20 sm:py-28">
  <SectionHeading id="experience" index={3} title={t('experience.title')} />

  <div class="relative mt-12 pl-6 sm:pl-8">
    <div class="rail" data-rail aria-hidden="true"></div>

    <ol class="space-y-0">
      {
        items.map((item) => {
          const [title, detail] = item[locale];
          return (
            <li
              data-reveal
              class="tl-item group relative grid grid-cols-1 gap-x-6 py-6 sm:grid-cols-[7rem_1fr]"
            >
              <span class="tl-dot" aria-hidden="true" />
              <span class="font-mono text-sm text-accent">{item.period}</span>
              <div>
                <p class="font-display text-base font-semibold transition-colors duration-300 group-hover:text-accent">
                  {title}
                </p>
                <p class="mt-1.5 text-sm text-muted">{detail}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
