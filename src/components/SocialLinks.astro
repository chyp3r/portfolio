    SOCIALS.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="me noopener noreferrer"
          aria-label={s.label}
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-surface text-muted transition-colors hover:border-accent hover:text-text"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={paths[s.key]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
