---
import { getLocale, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const groups: { title: string; items: string[] }[] = [
  {
    title: t('skills.group.languages'),
    items: ['Python', 'C / C++', 'Java', 'C#', 'Swift', 'Dart', 'SQL', 'R'],
  },
  {
    title: t('skills.group.llm'),
    items: [
      'LangChain',
      'LangGraph',
      'Agentic RAG',
      'MCP',
      'Qdrant',
      'pgvector',
      'Ollama',
      'vLLM',
      'LoRA / DPO',
      'Guardrails',
      'Hugging Face',
    ],
  },
  {
    title: t('skills.group.aiml'),
    items: [
      'PyTorch',
      'TensorFlow',
      'Transformers',
      'YOLOv8',
      'Vision Transformers',
      'OpenCV',
      'scikit-learn',
      'NumPy / Pandas',
      'Albumentations',
    ],
  },
  {
    title: t('skills.group.mobileGame'),
    items: ['Swift / UIKit', 'SwiftUI', 'Flutter', 'React Native', 'Firebase', 'Unity', 'Godot'],
  },
  {
    title: t('skills.group.tools'),
    items: [
      'FastAPI',
      'Django',
      'PostgreSQL',
      'Redis',
      'Docker',
      'Kubernetes',
      'React / TypeScript',
      'Streamlit',
      'Git',
      'Linux / WSL',
    ],
  },
];
---

<section class="container-page py-20 sm:py-28">
  <SectionHeading id="skills" title={t('skills.title')} />

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    {
      groups.map((g) => (
        <div data-reveal class="card p-6">
          <h3 class="eyebrow text-muted">{g.title}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
