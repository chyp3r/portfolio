---
import { SITE, SOCIALS } from '../consts';
import { getLocale, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';
import SocialLinks from './SocialLinks.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Primary CTA: email if one is configured, otherwise LinkedIn.
const linkedin = SOCIALS.find((s) => s.key === 'linkedin')?.href ?? '#';
const ctaHref = SITE.email ? `mailto:${SITE.email}` : linkedin;
---

<section class="container-page py-20 sm:py-28">
  <div
    class="reveal rounded-[var(--radius-card)] border border-border bg-surface p-8 shadow-card sm:p-12"
  >
    <SectionHeading id="contact" title={t('contact.title')} />
    <p class="mt-3 max-w-xl text-muted">{t('contact.body')}</p>
    <div class="mt-7 flex flex-wrap items-center gap-4">
      <a
        href={ctaHref}
        {...SITE.email ? {} : { target: '_blank', rel: 'noopener noreferrer' }}
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-contrast)] transition-transform hover:scale-[1.03]"
      >
        {t('contact.email')}
      </a>
      <SocialLinks />
    </div>
  </div>
</section>
