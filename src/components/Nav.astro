---
import { SITE } from '../consts';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.tsx';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const home = localizePath('/', locale);

const links = [
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#skills`, label: t('nav.skills') },
  { href: localizePath('/blog', locale), label: t('nav.writing') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
const initials = SITE.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header data-header transition:animate="fade" class="nav-shell sticky top-0 z-40">
  <div class="nav-shell__bg" aria-hidden="true"></div>

  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a href={home} class="nav-mark group">
      <span
        class="relative grid h-8 w-8 place-items-center overflow-hidden rounded-xl text-[11px] font-bold text-[var(--color-accent-contrast)] transition-transform duration-500 group-hover:rotate-[8deg] group-hover:scale-110"
        style="background-image: linear-gradient(135deg, var(--color-accent), var(--color-magenta) 55%, var(--color-cyan));"
      >
        {initials}
      </span>
      <span class="font-display text-sm font-semibold tracking-tight">
        {SITE.name}<span class="text-accent">.</span>
      </span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link
              class="link-slide text-sm text-muted transition-colors duration-300 hover:text-text aria-[current=true]:text-text"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <LangSwitch />
      <ThemeToggle client:load label={t('theme.toggle')} />

      <details class="group relative md:hidden">
        <summary
          class="icon-btn cursor-pointer list-none text-text [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <ul class="glass absolute right-0 mt-3 w-52 rounded-2xl p-2">
          {
            links.map((l, i) => (
              <li class="reveal" style={`--d:${i * 40}ms`}>
                <a
                  href={l.href}
                  class="block rounded-xl px-3 py-2 text-sm text-muted transition-colors hover:bg-bg-soft hover:text-text"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>

  <div class="progress-track" aria-hidden="true">
    <div class="progress-bar" data-progress></div>
  </div>
</header>
