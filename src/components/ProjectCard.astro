---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../lib/content';
import { slugOf } from '../lib/content';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { data } = project;
const href = localizePath(`/projects/${slugOf(project.id)}`, locale);
---

<article data-category={data.category} data-reveal class="card group flex flex-col">
  <a href={href} class="block" tabindex="-1" aria-hidden="true">
    <div class="relative aspect-[16/10] overflow-hidden bg-bg-soft">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.title}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 30vw, 90vw"
            class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.08]"
            loading="lazy"
          />
        ) : (
          <div class="card-fallback h-full w-full" />
        )
      }
      <!-- Bottom fade so the badge row always reads. -->
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 opacity-70 transition-opacity duration-500 group-hover:opacity-95"
        style="background: linear-gradient(to top, var(--color-surface), transparent);"
      >
      </div>
      <span class="glass absolute left-3 top-3 rounded-full px-2.5 py-0.5 text-[11px] font-medium">
        {t(`cat.${data.category}` as UIKey)}
      </span>
    </div>
  </a>

  <div class="relative z-[2] flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg font-semibold leading-tight">
        <a href={href} class="after:absolute after:inset-0">{data.title}</a>
      </h3>
      <span class="shrink-0 pt-1 font-mono text-xs text-muted">{data.year}</span>
    </div>
    <p class="line-clamp-3 text-sm text-muted">{data.summary}</p>
    <div class="mt-auto flex items-center justify-between gap-2 pt-1">
      <StatusBadge status={data.status} />
      <span
        class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-border text-muted transition-all duration-500 group-hover:translate-x-1 group-hover:border-accent group-hover:text-accent"
        aria-hidden="true"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m0 0-5-5m5 5-5 5" />
        </svg>
      </span>
    </div>
  </div>
</article>
