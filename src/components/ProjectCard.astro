---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../lib/content';
import { slugOf } from '../lib/content';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { data } = project;
const href = localizePath(`/projects/${slugOf(project.id)}`, locale);
---

<article
  data-category={data.category}
  class="reveal group relative flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface shadow-card transition-transform duration-300 hover:-translate-y-1"
>
  <a href={href} class="block">
    <div class="relative aspect-[16/10] overflow-hidden bg-bg-soft">
      {
        data.cover ? (
          <Image
            src={data.cover}
            alt={data.title}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 30vw, 90vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="h-full w-full bg-gradient-to-br from-accent/25 via-transparent to-cyan/20" />
        )
      }
      <span
        class="absolute left-3 top-3 rounded-full bg-bg/80 px-2.5 py-0.5 text-[11px] font-medium text-text backdrop-blur"
      >
        {t(`cat.${data.category}` as UIKey)}
      </span>
    </div>
  </a>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-display text-lg font-semibold leading-tight">
        <a href={href} class="after:absolute after:inset-0" >{data.title}</a>
      </h3>
      <span class="shrink-0 font-mono text-xs text-muted">{data.year}</span>
    </div>
    <p class="line-clamp-3 text-sm text-muted">{data.summary}</p>
    <div class="mt-auto flex items-center gap-2 pt-1">
      <StatusBadge status={data.status} />
    </div>
  </div>
</article>
