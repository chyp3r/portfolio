---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { id, eyebrow, title, subtitle } = Astro.props;
---

<div id={id} class="scroll-mt-24">
  {
    eyebrow && (
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
    )
  }
  <h2 class="text-2xl font-semibold sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-muted">{subtitle}</p>}
</div>
