---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { id, eyebrow, title, subtitle } = Astro.props;
---

<div id={id} class="scroll-mt-28">
  <div data-reveal>
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h2 class="text-3xl font-semibold sm:text-4xl">
      <span class="text-gradient">{title}</span>
    </h2>
    <hr class="rule mt-5 max-w-xs" />
    {subtitle && <p class="mt-4 max-w-2xl text-muted">{subtitle}</p>}
  </div>
</div>
