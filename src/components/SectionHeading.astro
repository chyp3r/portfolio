---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Optional running number, rendered as `01 —`. */
  index?: number;
}
const { id, eyebrow, title, subtitle, index } = Astro.props;
const num = index !== undefined ? String(index).padStart(2, '0') : undefined;
---

<div id={id} class="scroll-mt-28">
  <div data-reveal>
    {
      (num || eyebrow) && (
        <p class="mb-3 flex items-center gap-3">
          {num && <span class="section-index">{num}</span>}
          {num && <span class="h-px w-8 bg-border" aria-hidden="true" />}
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        </p>
      )
    }
    <h2 class="text-3xl font-semibold sm:text-4xl">
      <span class="text-gradient">{title}</span>
    </h2>
    <hr class="rule mt-5 max-w-xs" />
    {subtitle && <p class="mt-4 max-w-2xl text-muted">{subtitle}</p>}
  </div>
</div>
