---
import { SITE } from '../consts';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import SocialLinks from './SocialLinks.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="relative mt-28 overflow-hidden border-t border-border/60">
  <div class="container-page pt-12">
    <p
      class="watermark footer-parallax select-none text-[clamp(3rem,13vw,9rem)]"
      aria-hidden="true"
    >
      {SITE.name}
    </p>
  </div>

  <div
    class="container-page flex flex-col gap-6 border-t border-border/50 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="text-sm text-muted">© {year} · {SITE.role}</p>
      <p class="mt-1 text-xs text-muted/80">
        <a href="https://github.com/chyp3r/portfolio" class="link-slide">{t('footer.builtWith')}</a>
      </p>
    </div>
    <div class="flex items-center gap-4">
      <a href={localizePath('/blog', locale)} class="link-slide text-sm text-muted hover:text-text">
        {t('nav.writing')}
      </a>
      <SocialLinks />
    </div>
  </div>
</footer>
