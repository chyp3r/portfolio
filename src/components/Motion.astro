---
/**
 * Site-wide motion layer. One script drives every effect so pages stay cheap:
 *  - scroll reveals with automatic stagger
 *  - cursor spotlight on cards + ambient pointer glow (fine pointers only)
 *  - reading-progress bar and active-section highlighting in the nav
 *  - timeline rail fill
 * Everything re-initialises on `astro:page-load` so it survives view transitions.
 */
---

<script>
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Scroll-driven CSS animations handle the scrubbed scenes where supported. */
  const scrollTimeline = () =>
    !reduced() &&
    typeof CSS !== 'undefined' &&
    CSS.supports?.('animation-timeline', 'view()') === true &&
    !document.documentElement.hasAttribute('data-force-js-motion');

  let cleanups: (() => void)[] = [];

  function revealOnScroll() {
    // CSS owns the reveals when scroll timelines are available.
    if (scrollTimeline()) return;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (!items.length) return;
    if (reduced()) {
      items.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const index = Number(el.dataset.revealIndex ?? 0);
          el.style.setProperty('--d', `${Math.min(index, 8) * 70}ms`);
          el.classList.add('is-in');
          io.unobserve(el);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );

    // Stagger is per-group: siblings sharing a parent animate in sequence.
    const seen = new Map<Element, number>();
    items.forEach((el) => {
      const parent = el.parentElement ?? document.body;
      const n = seen.get(parent) ?? 0;
      seen.set(parent, n + 1);
      if (!el.dataset.revealIndex) el.dataset.revealIndex = String(n);
      io.observe(el);
    });
    cleanups.push(() => io.disconnect());

    // Safety net: if the observer never fires (background tab, odd browser),
    // show everything rather than leaving the page blank.
    const failsafe = window.setTimeout(
      () => items.forEach((el) => el.classList.add('is-in')),
      4000
    );
    cleanups.push(() => window.clearTimeout(failsafe));
  }

  /** Cursor spotlight + a little 3D tilt, from one shared pointer listener. */
  function cardSpotlight() {
    const tiltOk =
      window.matchMedia('(pointer: fine) and (min-width: 768px)').matches && !reduced();

    const onMove = (e: PointerEvent) => {
      const card = (e.target as HTMLElement)?.closest?.<HTMLElement>('.card');
      if (!card) return;
      const r = card.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
      if (!tiltOk) return;
      // −1..1 from the card centre, damped so it reads as depth, not a gimmick.
      card.style.setProperty('--tx', String((x / r.width - 0.5) * 2));
      card.style.setProperty('--ty', String((y / r.height - 0.5) * 2));
      card.dataset.tilt = 'on';
    };

    const onLeave = (e: PointerEvent) => {
      const card = (e.target as HTMLElement)?.closest?.<HTMLElement>('.card');
      if (!card) return;
      card.style.setProperty('--tx', '0');
      card.style.setProperty('--ty', '0');
      delete card.dataset.tilt;
    };

    document.addEventListener('pointermove', onMove, { passive: true });
    document.addEventListener('pointerout', onLeave, { passive: true });
    cleanups.push(() => {
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerout', onLeave);
    });
  }

  /** The neural orb leans toward the pointer. */
  function orbTilt() {
    const orb = document.querySelector<HTMLElement>('.orb');
    if (!orb || reduced() || !window.matchMedia('(pointer: fine)').matches) return;

    const onMove = (e: PointerEvent) => {
      const x = e.clientX / window.innerWidth - 0.5;
      const y = e.clientY / window.innerHeight - 0.5;
      orb.style.setProperty('--orb-tx', (x * 2).toFixed(3));
      orb.style.setProperty('--orb-ty', (y * 2).toFixed(3));
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    cleanups.push(() => window.removeEventListener('pointermove', onMove));
  }

  /**
   * Publishes scroll speed as `--scroll-v` (0..1) on <html>. One rAF loop that
   * parks itself once the page is still, so idle pages cost nothing.
   */
  function scrollVelocity() {
    if (reduced()) return;
    const root = document.documentElement;
    let last = window.scrollY;
    let v = 0;
    let raf = 0;
    let running = false;

    const tick = () => {
      const now = window.scrollY;
      const delta = Math.abs(now - last);
      last = now;
      v += (Math.min(delta / 60, 1) - v) * 0.16;
      root.style.setProperty('--scroll-v', v.toFixed(3));
      if (v < 0.002 && delta === 0) {
        root.style.setProperty('--scroll-v', '0');
        running = false;
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const kick = () => {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    };

    window.addEventListener('scroll', kick, { passive: true });
    cleanups.push(() => {
      window.removeEventListener('scroll', kick);
      cancelAnimationFrame(raf);
      running = false;
      root.style.removeProperty('--scroll-v');
    });
  }

  function pointerGlow() {
    const glow = document.querySelector<HTMLElement>('[data-cursor-glow]');
    if (!glow) return;
    const fine = window.matchMedia('(pointer: fine)').matches && !reduced();
    document.body.dataset.pointer = fine ? 'fine' : 'coarse';
    if (!fine) return;

    let x = window.innerWidth / 2;
    let y = window.innerHeight / 2;
    let cx = x;
    let cy = y;
    let raf = 0;

    const onMove = (e: PointerEvent) => {
      x = e.clientX;
      y = e.clientY;
    };
    const tick = () => {
      cx += (x - cx) * 0.08;
      cy += (y - cy) * 0.08;
      glow.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      raf = requestAnimationFrame(tick);
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    raf = requestAnimationFrame(tick);
    cleanups.push(() => {
      window.removeEventListener('pointermove', onMove);
      cancelAnimationFrame(raf);
    });
  }

  function scrollDriven() {
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const header = document.querySelector<HTMLElement>('[data-header]');
    const rails = Array.from(document.querySelectorAll<HTMLElement>('[data-rail]'));
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const sections = navLinks
      .map((a) => {
        const id = a.hash.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .map((el, i) => ({ el, link: navLinks[i] }))
      .filter((s): s is { el: HTMLElement; link: HTMLAnchorElement } => Boolean(s.el));

    let ticking = false;
    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const y = window.scrollY;

      if (bar) bar.style.setProperty('--p', String(max > 0 ? Math.min(y / max, 1) : 0));
      if (header) header.dataset.scrolled = y > 12 ? 'true' : 'false';

      rails.forEach((rail) => {
        const r = rail.getBoundingClientRect();
        const fill = (window.innerHeight * 0.72 - r.top) / Math.max(r.height, 1);
        rail.style.setProperty('--fill', String(Math.max(0, Math.min(1, fill))));
      });

      if (sections.length) {
        const marker = y + window.innerHeight * 0.32;
        let active = sections[0];
        for (const s of sections) if (s.el.offsetTop <= marker) active = s;
        sections.forEach((s) =>
          s.link.setAttribute('aria-current', String(s === active && y > 80))
        );
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
    cleanups.push(() => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    });
  }

  /** Rotating word in the hero. */
  function rotator() {
    const el = document.querySelector<HTMLElement>('[data-rotator]');
    if (!el) return;
    const words = (el.dataset.rotator ?? '').split('|').filter(Boolean);
    if (words.length < 2 || reduced()) return;

    let i = 0;
    const show = (text: string) => {
      el.textContent = text;
      // Reflow between the two states instead of rAF, so the swap still
      // completes in a background tab (where rAF never fires).
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = 'translateY(0.35em)';
      void el.offsetWidth;
      el.style.transition = '';
      el.style.opacity = '1';
      el.style.transform = 'none';
    };

    const id = window.setInterval(() => {
      if (document.hidden) return;
      i = (i + 1) % words.length;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-0.35em)';
      window.setTimeout(() => show(words[i]), 220);
    }, 2800);

    // Coming back to the tab mid-swap should never leave an empty slot.
    const onVisible = () => {
      if (!document.hidden) show(words[i]);
    };
    document.addEventListener('visibilitychange', onVisible);

    cleanups.push(() => {
      window.clearInterval(id);
      document.removeEventListener('visibilitychange', onVisible);
    });
  }

  /** Buttons drift a little toward the cursor. */
  function magnetic() {
    if (reduced() || !window.matchMedia('(pointer: fine)').matches) return;
    const targets = Array.from(document.querySelectorAll<HTMLElement>('.magnetic'));
    if (!targets.length) return;

    const onMove = (e: PointerEvent) => {
      targets.forEach((el) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const reach = Math.max(r.width, r.height) * 0.9;
        const dist = Math.hypot(dx, dy);
        const pull = dist < reach ? 1 - dist / reach : 0;
        el.style.setProperty('--mgx', `${dx * 0.22 * pull}px`);
        el.style.setProperty('--mgy', `${dy * 0.22 * pull}px`);
      });
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    cleanups.push(() => {
      window.removeEventListener('pointermove', onMove);
      targets.forEach((el) => {
        el.style.removeProperty('--mgx');
        el.style.removeProperty('--mgy');
      });
    });
  }

  /** Hero stats count up the first time they scroll into view. */
  function counters() {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
    if (!nodes.length) return;
    if (reduced()) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count);
          if (!Number.isFinite(target)) return;
          const suffix = el.dataset.countSuffix ?? '';
          const start = performance.now();
          const dur = 1100;
          const step = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = `${Math.round(target * eased)}${suffix}`;
            if (p < 1) requestAnimationFrame(step);
          };
          el.textContent = `0${suffix}`;
          requestAnimationFrame(step);
        });
      },
      { threshold: 0.6 }
    );
    nodes.forEach((n) => io.observe(n));
    cleanups.push(() => io.disconnect());
  }

  /** Back-to-top button with a scroll-progress ring. */
  function backToTop() {
    const btn = document.querySelector<HTMLElement>('[data-to-top]');
    if (!btn) return;
    const ring = btn.querySelector<SVGCircleElement>('[data-to-top-ring]');
    const len = ring ? (ring.getTotalLength?.() ?? 0) : 0;
    if (ring && len) {
      ring.style.strokeDasharray = String(len);
      ring.style.strokeDashoffset = String(len);
    }

    const onClick = () => window.scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' });
    btn.addEventListener('click', onClick);

    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const p = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      btn.dataset.show = window.scrollY > window.innerHeight * 0.8 ? 'true' : 'false';
      if (ring && len) ring.style.strokeDashoffset = String(len * (1 - p));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    cleanups.push(() => {
      btn.removeEventListener('click', onClick);
      window.removeEventListener('scroll', update);
    });
  }

  /** Manifesto word lighting for browsers without scroll timelines. */
  function manifestoFallback() {
    const text = document.querySelector<HTMLElement>('[data-manifesto]');
    if (!text) return;
    const words = Array.from(text.querySelectorAll<HTMLElement>('.manifesto__word'));
    if (!words.length) return;

    if (scrollTimeline() || reduced()) {
      if (reduced()) words.forEach((w) => w.classList.add('is-lit'));
      return;
    }

    const scene = text.closest<HTMLElement>('.manifesto');
    if (!scene) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const r = scene.getBoundingClientRect();
      const travel = r.height - window.innerHeight;
      const p = travel > 0 ? Math.min(Math.max(-r.top / travel, 0), 1) : 0;
      // Same 18%–76% window the CSS ranges use.
      const eased = (p - 0.18) / 0.58;
      const lit = Math.round(Math.min(Math.max(eased, 0), 1) * words.length);
      words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
    cleanups.push(() => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    });
  }

  function init() {
    cleanups.forEach((fn) => fn());
    cleanups = [];
    revealOnScroll();
    cardSpotlight();
    scrollVelocity();
    orbTilt();
    pointerGlow();
    scrollDriven();
    rotator();
    magnetic();
    manifestoFallback();
    counters();
    backToTop();
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init, { once: true });
</script>
