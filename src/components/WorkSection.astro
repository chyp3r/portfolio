---
import type { ProjectEntry } from '../lib/content';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';
import { CATEGORIES } from '../consts';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: ProjectEntry[];
}
const { projects } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Only show filters for categories actually present in this set.
const present = CATEGORIES.filter((c) => projects.some((p) => p.data.category === c));
const filters = [{ key: 'all', label: t('work.filter.all') }, ...present.map((c) => ({
  key: c,
  label: t(`cat.${c}` as UIKey),
}))];
---

<section class="container-page py-20 sm:py-28">
  <SectionHeading
    id="work"
    eyebrow={t('hero.eyebrow')}
    title={t('work.title')}
    subtitle={t('work.subtitle')}
  />

  <div
    class="mt-8 flex flex-wrap gap-2"
    role="group"
    aria-label={t('work.title')}
    data-filter-group
  >
    {
      filters.map((f, i) => (
        <button
          type="button"
          data-filter={f.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:text-text aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-[var(--color-accent-contrast)]"
        >
          {f.label}
        </button>
      ))
    }
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <div class="mt-10">
    <a
      href={localizePath('/projects', locale)}
      class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline"
    >
      {t('work.viewAll')}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter-group]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  if (group && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const value = btn.dataset.filter;
      group.querySelectorAll('[data-filter]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === btn))
      );
      cards.forEach((card) => {
        const show = value === 'all' || card.dataset.category === value;
        card.toggleAttribute('hidden', !show);
      });
    });
  }
</script>
