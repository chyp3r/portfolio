---
import { getLocale, useTranslations } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';

interface Props {
  status: 'shipped' | 'finalist' | 'award' | 'wip' | 'archived';
}
const { status } = Astro.props;
const t = useTranslations(getLocale(Astro.url));

const tone: Record<Props['status'], string> = {
  shipped: 'text-cyan border-cyan/40',
  finalist: 'text-accent border-accent/40',
  award: 'text-accent border-accent/40',
  wip: 'text-muted border-border',
  archived: 'text-muted border-border',
};
---

<span
  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-medium ${tone[status]}`}
>
  {t(`status.${status}` as UIKey)}
</span>
