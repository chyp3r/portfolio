---
import { SITE } from '../consts';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import SocialLinks from './SocialLinks.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const home = localizePath('/', locale);

// The CV button only renders if you drop a file at public/cv.pdf.
const cvHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}${SITE.cvPath}`;
---

<section class="container-page relative pt-20 pb-16 sm:pt-28 sm:pb-24">
  <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-accent">
    {t('site.tagline')}
  </p>

  <h1 class="reveal mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] sm:text-6xl" style="animation-delay:.05s">
    {t('hero.title')}
  </h1>

  <p class="reveal mt-6 max-w-2xl text-lg text-muted" style="animation-delay:.1s">
    {t('hero.lede')}
  </p>

  <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="animation-delay:.15s">
    <a
      href={`${home}#work`}
      class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-contrast)] transition-transform hover:scale-[1.03]"
    >
      {t('hero.cta.work')}
    </a>
    <a
      href={cvHref}
      data-cv-link
      hidden
      class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold text-text transition-colors hover:border-accent"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
      </svg>
      {t('hero.cta.cv')}
    </a>
    <SocialLinks class="ml-1" />
  </div>
</section>

<script>
  // Reveal the CV button only when the PDF actually exists.
  const link = document.querySelector<HTMLAnchorElement>('[data-cv-link]');
  if (link) {
    fetch(link.href, { method: 'HEAD' })
      .then((r) => {
        if (r.ok) link.hidden = false;
      })
      .catch(() => {});
  }
</script>
