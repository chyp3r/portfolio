---
import type { Category } from '../consts';

/**
 * Deterministic cover art for projects that have no image.
 * The hue is derived from the title, so every project keeps a stable identity
 * while the whole grid still reads as one palette.
 */
interface Props {
  title: string;
  category: Category;
  /** `card` for grid covers, `hero` for the project page banner. */
  variant?: 'card' | 'hero';
  class?: string;
}
const { title, category, variant = 'card', class: className = '' } = Astro.props;

const hash = [...title].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 360, 7);
const hue = hash;

const monogram = title
  .replace(/[^\p{L}\p{N} ]/gu, ' ')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');

// A different mark per focus area keeps the grid scannable at a glance.
const glyphs: Record<Category, string> = {
  ai: 'M12 3a4 4 0 0 1 4 4v1a4 4 0 0 1 0 8v1a4 4 0 0 1-8 0v-1a4 4 0 0 1 0-8V7a4 4 0 0 1 4-4Z',
  mobile: 'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm3 15h4',
  game: 'M7 12h4m-2-2v4m5-1h.01M17 11h.01M6 7h12a4 4 0 0 1 4 4v2a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-2a4 4 0 0 1 4-4Z',
  research: 'M10 3v6.5L4.5 18A2 2 0 0 0 6.2 21h11.6a2 2 0 0 0 1.7-3L14 9.5V3M9 3h6M8.5 14h7',
  education: 'M3 8.5 12 4l9 4.5-9 4.5-9-4.5Zm3 3v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5',
};
---

<div
  class:list={['ph', variant === 'hero' && 'ph--hero', className]}
  style={`--ph-hue:${hue}`}
  aria-hidden="true"
>
  <div class="ph__mesh"></div>
  <div class="ph__rings"></div>
  <svg class="ph__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
    <path d={glyphs[category]} stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="ph__mono">{monogram}</span>
</div>
