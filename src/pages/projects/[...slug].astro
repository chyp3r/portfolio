---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getProjects, getProjectSiblings, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return Promise.all(
    projects.map(async (entry) => {
      const { prev, next } = await getProjectSiblings(entry);
      return { params: { slug: slugOf(entry.id) }, props: { entry, prev, next } };
    })
  );
}

const { entry, prev, next } = Astro.props;
---

<ProjectLayout entry={entry} prev={prev} next={next} />
