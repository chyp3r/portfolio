---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import { getProjects } from '../../lib/content';
import { getLocale, useTranslations } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Base title={t('archive.title')} description={t('archive.subtitle')}>
  <div class="container-page py-16 sm:py-24">
    <SectionHeading eyebrow={t('nav.work')} title={t('archive.title')} subtitle={t('archive.subtitle')} />
    <ArchiveList projects={projects} />
  </div>
</Base>
