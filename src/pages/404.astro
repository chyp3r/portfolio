---
import Base from '../layouts/Base.astro';
import { useTranslations, localizePath } from '../i18n/utils';

// 404 always renders in the default locale.
const t = useTranslations('en');
---

<Base title={t('notFound.title')} noindex>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="font-mono text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{t('notFound.title')}</h1>
    <p class="mt-2 text-muted">{t('notFound.body')}</p>
    <a
      href={localizePath('/', 'en')}
      class="mt-8 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-[var(--color-accent-contrast)]"
    >
      {t('notFound.home')}
    </a>
  </div>
</Base>
