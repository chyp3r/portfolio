---
import Base from '../layouts/Base.astro';
import { useTranslations, localizePath } from '../i18n/utils';

// 404 always renders in the default locale.
const t = useTranslations('en');
---

<Base title={t('notFound.title')} noindex>
  <div class="container-page flex min-h-[70vh] flex-col items-center justify-center text-center">
    <div class="relative grid place-items-center">
      <div class="orbit" style="width:18rem;height:18rem" aria-hidden="true"></div>
      <div
        class="orbit"
        style="width:11rem;height:11rem;animation-duration:14s;animation-direction:reverse"
        aria-hidden="true"
      >
      </div>
      <p class="text-gradient font-display text-7xl font-bold sm:text-8xl">404</p>
    </div>
    <h1 class="mt-8 text-3xl font-semibold">{t('notFound.title')}</h1>
    <p class="mt-3 text-muted">{t('notFound.body')}</p>
    <a href={localizePath('/', 'en')} class="btn btn-primary mt-9">
      {t('notFound.home')}
    </a>
  </div>
</Base>
